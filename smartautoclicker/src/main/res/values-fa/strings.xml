    <string name="activity_settings_title">تنظیمات</string>

    <string name="field_show_scenario_filters_ui_title">نمایش فیلترهای سناریوها</string>
    <string name="field_show_scenario_filters_ui_desc">نمایش یا پنهان‌سازی فیلترها در صفحه فهرست سناریوها.</string>

    <string name="field_legacy_action_ui_title">رابط کاربری قدیمی اقدام‌ها</string>
    <string name="field_legacy_action_ui_desc">تغییر نمایش اقدام به صورت فهرست. برای سناریوهای پیچیده کاربرد دارد.</string>

    <string name="field_legacy_notification_ui_title">رابط کاربری قدیمی اعلان‌ها</string>
    <string name="field_legacy_notification_ui_desc">استفاده از دکمه‌های سیستمی به‌جای دکمه‌های نمادین در اعلان.</string>

    <string name="field_force_entire_screen_title">اجبار به تمام صفحه</string>
    <string name="field_force_entire_screen_desc">اجبار انتخابگر ضبط صفحه به «تمام صفحه». ممکن است بسته به دستگاه شما کار نکند</string>

    <string name="field_show_on_lock_screen_title">نمایش در صفحه قفل</string>
    <string name="field_show_on_lock_screen_desc">نمایان نگه داشتن منوی شناور هنگام قفل بودن دستگاه.</string>

    <string name="field_input_block_workaround_title">رفع مسدودسازی صفحه لمسی</string>
    <string name="field_input_block_workaround_desc">در دستگاه‌های Pixel با Android 15، استفاده از کلیک‌کننده خودکار می‌تواند صفحه لمسی را مسدود کند.\nبرای رفع مسدودسازی، باید هم‌زمان صفحه را با چند انگشت لمس کنید. این تنظیم تلاش می‌کند هر ۱۰ ثانیه این کار را شبیه‌سازی کند.</string>

