<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/AppTheme.Widget.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margin_horizontal_default"
    android:layout_marginVertical="@dimen/margin_horizontal_small">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_horizontal_default"
        android:layout_marginTop="@dimen/margin_vertical_default"
        android:layout_marginBottom="@dimen/margin_vertical_small">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/event_name_text"
            style="@style/AppTheme.TextAppearance.ListItemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_horizontal_large"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/timing_container"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="My cool event"/>

        <FrameLayout
            android:id="@+id/timing_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@id/event_name_text"
            app:layout_constraintStart_toEndOf="@id/event_name_text"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/legacy_time_text"
                style="@style/AppTheme.TextAppearance.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:singleLine="true"
                tools:text="00:00:26.804" />

            <TableLayout
                android:id="@+id/timing_table"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/margin_vertical_mini"
                android:visibility="gone"
                tools:visibility="visible">

                <TableRow
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/detecting_timing_value"
                        style="@style/AppTheme.TextAppearance.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:gravity="end"
                        android:singleLine="true"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="+23.4" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/AppTheme.TextAppearance.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_horizontal_mini"
                        android:singleLine="true"
                        android:text="@string/item_event_occurrence_milliseconds"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/AppTheme.TextAppearance.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_horizontal_mini"
                        android:singleLine="true"
                        android:text="@string/item_event_occurrence_detecting_label"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </TableRow>

                <TableRow
                    android:id="@+id/actions_timing_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_vertical_mini">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/actions_timing_value"
                        style="@style/AppTheme.TextAppearance.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:gravity="end"
                        android:singleLine="true"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="+10.91" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/AppTheme.TextAppearance.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_horizontal_mini"
                        android:singleLine="true"
                        android:text="@string/item_event_occurrence_milliseconds"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/AppTheme.TextAppearance.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_horizontal_mini"
                        android:singleLine="true"
                        android:text="@string/item_event_occurrence_actions_label"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </TableRow>

            </TableLayout>

        </FrameLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/occurrence_text"
            style="@style/AppTheme.Field.SubText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_vertical_small"
            android:layout_marginEnd="@dimen/margin_horizontal_default"
            app:layout_constraintTop_toBottomOf="@id/event_name_text"
            app:layout_constraintBottom_toTopOf="@id/conditions_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/chevron"
            tools:text="Frame #1234"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/conditions_text"
            style="@style/AppTheme.Field.SubText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_vertical_mini"
            android:layout_marginEnd="@dimen/margin_horizontal_default"
            app:layout_constraintTop_toBottomOf="@id/occurrence_text"
            app:layout_constraintBottom_toTopOf="@id/actions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/chevron"
            tools:text="Condition name"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/chevron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/timing_container"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_right"
            tools:ignore="ContentDescription"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/actions"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/margin_vertical_small"
            android:layout_marginEnd="@dimen/margin_horizontal_default"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/conditions_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/chevron"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:listitem="@layout/item_timeline_actions"
            tools:itemCount="4"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
