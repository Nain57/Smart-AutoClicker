<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_card"
    style="@style/AppTheme.Widget.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margin_horizontal_default"
    android:layout_marginVertical="@dimen/margin_vertical_default"
    app:strokeColor="@color/gesture_release_color"
    app:strokeWidth="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/margin_vertical_default">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/motion_title"
            style="@style/AppTheme.TextAppearance.ListItemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_vertical_small"
            android:layout_marginHorizontal="@dimen/margin_horizontal_default"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/button_expand_collapse"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/motion_desc"
            android:text="@string/item_title_gesture_release"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/motion_desc"
            style="@style/AppTheme.TextAppearance.ListItemSubText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_horizontal_default"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/button_expand_collapse"
            app:layout_constraintTop_toBottomOf="@id/motion_title"
            app:layout_constraintBottom_toTopOf="@id/divider_top"
            android:gravity="center_vertical"
            android:text="@string/item_desc_gesture_release"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_expand_collapse"
            style="@style/AppTheme.Widget.IconButton"
            android:layout_marginHorizontal="@dimen/margin_horizontal_default"
            app:layout_constraintStart_toEndOf="@id/motion_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/divider_top"
            app:icon="@drawable/ic_chevron_up"/>

        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/divider_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_vertical_default"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/button_expand_collapse"
            app:layout_constraintBottom_toTopOf="@id/field_when"/>

        <include layout="@layout/include_input_field_dropdown"
            android:id="@+id/field_when"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_horizontal_default"
            android:layout_marginVertical="@dimen/margin_vertical_default"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_top"
            app:layout_constraintBottom_toTopOf="@id/field_hold_duration"/>

        <include layout="@layout/include_field_text_input"
            android:id="@+id/field_hold_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_vertical_small"
            android:layout_marginHorizontal="@dimen/margin_horizontal_default"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/field_when"
            app:layout_constraintBottom_toTopOf="@id/card_hold_info"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_hold_info"
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_horizontal_default"
            android:layout_marginTop="@dimen/margin_vertical_default"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/field_hold_duration"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/margin_horizontal_default"
                android:paddingVertical="@dimen/margin_vertical_default">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_release_desc"
                    style="@style/AppTheme.TextAppearance.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="@string/field_gesture_release_desc_now"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_hold_behaviour"
                    style="@style/AppTheme.TextAppearance.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_vertical_default"
                    android:text="@string/field_gesture_release_hold_behaviour"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>