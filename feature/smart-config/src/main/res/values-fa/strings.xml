    <!-- Dialogs warning/error ===================================================================================== -->

    <string name="warning_dialog_message_toggle_action_from_another_scenario">این رویداد یک یا چند اقدام تغییر وضعیت رویداد دارد که به رویدادی از سناریوی دیگری ارجاع می‌دهند.\nپیش از ذخیره سناریو، باید رویدادهای مقصد آن‌ها را به‌روزرسانی کنید.</string>
    <string name="warning_dialog_message_event_delete_associated_action">یک یا چند اقدام به این رویداد ارجاع دارند. حذف این رویداد اقدامات مرتبط با آن را نیز حذف خواهد کرد.\nآیا مطمئن هستید؟</string>
    <string name="warning_dialog_message_condition_delete_associated_action">یک یا چند اقدام به این شرط ارجاع دارند. حذف این شرط اقدامات مرتبط با آن را نیز حذف خواهد کرد.\nآیا مطمئن هستید؟</string>
    <string name="warning_dialog_message_close_without_saving">تغییرات ذخیره‌نشده دارید، آیا می‌خواهید آن‌ها را نادیده بگیرید؟</string>
    <string name="warning_dialog_message_delete">در حال حذف این مورد هستید، آیا مطمئن هستید؟</string>

    <string name="error_dialog_message_scenario_saving">سناریوی شما به دلیل یک خطای داخلی قابل ذخیره نیست.\nآیا می‌خواهید آن را ویرایش کنید یا تمام تغییرات خود را لغو کنید؟</string>
    <string name="error_dialog_message_error_native_lib">برنامه Klick\'r به‌درستی نصب نشده است و نمی‌تواند تشخیص را آغاز کند.\n\nاگر آن را از یک فروشگاه معتبر برنامه نصب کرده‌اید، لطفاً در GitHub با ما تماس بگیرید، زیرا این کار به حل این مشکل کمک خواهد کرد.</string>
    <string name="error_dialog_message_screen_capture_unsupported">صفحه دستگاه شما به دلیل محدودیت درایور توسط Klick\'r قابل خواندن نیست.\n\nمتأسفانه این یک محدودیت سخت‌افزاری است که راهکاری ندارد. لطفاً مدل دستگاه خود را در GitHub با ما در میان بگذارید تا بتوانیم دستگاه‌های تحت‌تأثیر را ردیابی کنیم.</string>


