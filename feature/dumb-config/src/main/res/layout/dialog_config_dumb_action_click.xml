<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/AppTheme.Dialog.BackgroundLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/include_dialog_navigation_top_bar"
        android:id="@+id/layout_top_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/margin_vertical_large"
        android:layout_marginBottom="@dimen/margin_vertical_extra_large"
        android:scrollbars="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            style="@style/AppTheme.Dialog.BackgroundLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_horizontal_default"
            android:layout_marginBottom="@dimen/margin_vertical_default">

            <include layout="@layout/include_field_text_input"
                android:id="@+id/field_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/field_duration"/>

            <include layout="@layout/include_field_text_input"
                android:id="@+id/field_duration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/field_name"
                app:layout_constraintBottom_toTopOf="@id/field_repeat"/>

            <include layout="@layout/include_field_text_input"
                android:id="@+id/field_repeat_delay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_vertical_default"
                android:layout_marginEnd="@dimen/margin_horizontal_default"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/field_repeat"
                app:layout_constraintTop_toBottomOf="@id/field_duration"
                app:layout_constraintBottom_toTopOf="@id/field_position_x" />

            <include layout="@layout/include_field_text_input_with_checkbox"
                android:id="@+id/field_repeat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/field_repeat_delay"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/field_repeat_delay"
                app:layout_constraintBottom_toBottomOf="@id/field_repeat_delay"/>

            <include layout="@layout/include_field_text_input"
                android:id="@+id/field_position_x"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_vertical_default"
                android:layout_marginEnd="@dimen/margin_horizontal_default"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/field_position_y"
                app:layout_constraintTop_toBottomOf="@id/field_repeat"
                app:layout_constraintBottom_toTopOf="@id/button_select_position"/>

            <include layout="@layout/include_field_text_input"
                android:id="@+id/field_position_y"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/field_position_x"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/field_position_x"
                app:layout_constraintBottom_toBottomOf="@id/field_position_x"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_select_position"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_vertical_large"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/field_position_x"
                app:layout_constraintBottom_toBottomOf="parent"
                app:icon="@drawable/ic_position"
                android:text="@string/button_title_position"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>